---
import { getEntry } from 'astro:content';
const imagesEntry = await getEntry('siteImages', 'images');
const images = imagesEntry;
const PLACEHOLDER = "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20400%20500%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%238248E8%22%2F%3E%3Cstop%20offset%3D%22.55%22%20stop-color%3D%22%235F1CEC%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23241046%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22400%22%20height%3D%22500%22%20fill%3D%22url%28%2523g%29%22%2F%3E%3Cg%20stroke%3D%22%23ffffff%22%20stroke-opacity%3D%220.20%22%20stroke-width%3D%222%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M-20%20360%20C120%20290%20210%20420%20430%20320%22%2F%3E%3Cpath%20d%3D%22M-20%20410%20C140%20350%20250%20470%20430%20390%22%2F%3E%3Cpath%20d%3D%22M-20%20300%20C120%20250%20210%20350%20430%20260%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.15%22%3E%3Ccircle%20cx%3D%22205%22%20cy%3D%22180%22%20r%3D%2230%22%2F%3E%3Cpath%20d%3D%22M205%20212%20C182%20232%20188%20300%20172%20350%20L196%20350%20C205%20316%20212%20316%20220%20350%20L244%20350%20C230%20300%20236%20232%20205%20212%20Z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E'),linear-gradient(140deg,#CDB4E8,#9B6FD8 55%,#5F1CEC)";
import Base from '../../layouts/Base.astro';
---
<Base title="Danzare per il pianeta — Ecstatic Grooves">
<section class="block" style="padding-top:140px">
    <div class="wrap">
      <article class="article">
        <span class="back" href="/blog" data-it="← Torna al blog" data-en="← Back to the blog">← Torna al blog</span>
        <p class="eyebrow" data-it="Restituire" data-en="Giving back">Restituire</p>
        <h1 data-it="Danzare per il pianeta" data-en="Dancing for the planet">Danzare per il pianeta</h1>
        <p class="ameta" data-it="di Holly" data-en="by Holly">di Holly</p>
        <div class="photo tall" style={`margin-bottom:32px;background-image:${images.data.blogCoverPlanet ? `url('${images.data.blogCoverPlanet}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div>
        <div class="abody">
          <p data-it="«I tempi duri richiedono una danza furiosa.» Le parole di Alice Walker valgono per noi, e valgono anche per il pianeta. Clima estremo, un'emergenza climatica sempre più grave: vediamo e sentiamo che anche la terra sta attraversando tempi difficili, e ha bisogno di tutto l'aiuto possibile. Così danziamo anche per il pianeta, per darle una mano." data-en="&ldquo;Hard times require furious dancing.&rdquo; Alice Walker's words are true for us, and they're true for the planet too. Extreme weather, a worsening climate emergency: we can really see and feel that the earth is also going through hard times, and she needs all the help she can get. So let's also dance for the planet and help support her.">«I tempi duri richiedono una danza furiosa.» Le parole di Alice Walker valgono per noi, e valgono anche per il pianeta. Clima estremo, un'emergenza climatica sempre più grave: vediamo e sentiamo che anche la terra sta attraversando tempi difficili, e ha bisogno di tutto l'aiuto possibile. Così danziamo anche per il pianeta, per darle una mano.</p>
          <p data-it="Ecco perché il 5% di ogni biglietto che vendiamo per i nostri eventi va a EarthPercent, la fondazione per il clima e la natura dell'industria musicale, co-fondata da Brian Eno. (Trasparenza totale: Holly lavora proprio in EarthPercent, ed è anche così che li abbiamo conosciuti, e perché ci fidiamo di dove vanno esattamente i fondi.)" data-en="That's why 5% of every ticket we sell for our events goes to EarthPercent, the music industry's climate and nature foundation, co-founded by Brian Eno. (Full disclosure: Holly actually works at EarthPercent, which is partly how we found them, and why we trust exactly where the money goes.)">Ecco perché il 5% di ogni biglietto che vendiamo per i nostri eventi va a EarthPercent, la fondazione per il clima e la natura dell'industria musicale, co-fondata da Brian Eno. (Trasparenza totale: Holly lavora proprio in EarthPercent, ed è anche così che li abbiamo conosciuti, e perché ci fidiamo di dove vanno esattamente i fondi.)</p>
          <p data-it="EarthPercent finanzia progetti eccellenti che fanno un lavoro concreto per il clima, dalle campagne dal basso alla conservazione e alla ricerca. Puoi vedere esattamente cosa finanziano su <a href='https://www.earthpercent.org/whatwefund' target='_blank' rel='noopener'>earthpercent.org/whatwefund</a>." data-en="EarthPercent funds excellent projects doing real work in climate action, from grassroots campaigns to conservation and research. See exactly what they fund at <a href='https://www.earthpercent.org/whatwefund' target='_blank' rel='noopener'>earthpercent.org/whatwefund</a>.">EarthPercent finanzia progetti eccellenti che fanno un lavoro concreto per il clima, dalle campagne dal basso alla conservazione e alla ricerca. Puoi vedere esattamente cosa finanziano su <a href="https://www.earthpercent.org/whatwefund" target="_blank" rel="noopener">earthpercent.org/whatwefund</a>.</p>
        </div>
        <div class="share">
          <span data-it="Condividi" data-en="Share">Condividi</span>
          <a href="#" onclick="return sh('wa')">WhatsApp</a>
          <a href="#" onclick="return sh('fb')">Facebook</a>
          <a href="#" onclick="return sh('li')">LinkedIn</a>
          <button onclick="copyLink(this)" data-it="Copia link" data-en="Copy link">Copia link</button>
        </div>
      </article>
    </div>
  </section>
</Base>
