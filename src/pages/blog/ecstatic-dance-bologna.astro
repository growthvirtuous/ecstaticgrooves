          <button onclick="copyLink(this)" data-it="Copia link" data-en="Copy link">Copia link</button>
        </div>
        <a class="next-article" href="/blog/finding-my-way-home">
          <span class="next-label" data-it="Prossimo articolo" data-en="Next article">Prossimo articolo</span>
          <span class="next-title" data-it="Ritrovare la strada di casa →" data-en="Finding my way home →">Ritrovare la strada di casa →</span>
        </a>
      </article>
    </div>
  </section>
</Base>
