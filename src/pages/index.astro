---
import { getEntry } from 'astro:content';
const imagesEntry = await getEntry('siteImages', 'images');
const images = imagesEntry;
const PLACEHOLDER = "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20400%20500%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%238248E8%22%2F%3E%3Cstop%20offset%3D%22.55%22%20stop-color%3D%22%235F1CEC%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23241046%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22400%22%20height%3D%22500%22%20fill%3D%22url%28%2523g%29%22%2F%3E%3Cg%20stroke%3D%22%23ffffff%22%20stroke-opacity%3D%220.20%22%20stroke-width%3D%222%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M-20%20360%20C120%20290%20210%20420%20430%20320%22%2F%3E%3Cpath%20d%3D%22M-20%20410%20C140%20350%20250%20470%20430%20390%22%2F%3E%3Cpath%20d%3D%22M-20%20300%20C120%20250%20210%20350%20430%20260%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.15%22%3E%3Ccircle%20cx%3D%22205%22%20cy%3D%22180%22%20r%3D%2230%22%2F%3E%3Cpath%20d%3D%22M205%20212%20C182%20232%20188%20300%20172%20350%20L196%20350%20C205%20316%20212%20316%20220%20350%20L244%20350%20C230%20300%20236%20232%20205%20212%20Z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E'),linear-gradient(140deg,#CDB4E8,#9B6FD8 55%,#5F1CEC)";
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const testimonials = await getCollection('testimonials');
const homeEntry = await getEntry('homeText', 'text');
const home = homeEntry.data;
---
<Base title="Ecstatic Grooves — Danza consapevole a Bologna">
<div class="hero">
    <video class="hero-vid" autoplay muted loop playsinline poster={images.data.heroPoster ? images.data.heroPoster : "/images/hero-poster.jpg"}>
      <source src="/videos/hero.mp4" type="video/mp4">
    </video>
    <div class="hero-scrim"></div>
    <div class="hero-inner">
      <p class="eyebrow" data-it={home.hero.eyebrowIt} data-en={home.hero.eyebrowEn}>{home.hero.eyebrowIt}</p>
      <h1 data-it={home.hero.titleIt} data-en={home.hero.titleEn} set:html={home.hero.titleIt}></h1>
      <p class="sub" data-it={home.hero.subIt} data-en={home.hero.subEn}>{home.hero.subIt}</p>
      <div class="hero-cta">
        <a class="btn btn-solid" href="/eventi" data-it={home.hero.ctaPrimaryIt} data-en={home.hero.ctaPrimaryEn}>{home.hero.ctaPrimaryIt}</a>
        <a class="btn btn-ghost hero-ghost" href="/esperienza" data-it={home.hero.ctaSecondaryIt} data-en={home.hero.ctaSecondaryEn}>{home.hero.ctaSecondaryIt}</a>
      </div>
    </div>
  </div>

  <section class="block">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow" data-it={home.whatWeDo.eyebrowIt} data-en={home.whatWeDo.eyebrowEn}>{home.whatWeDo.eyebrowIt}</p>
        <h2 data-it={home.whatWeDo.titleIt} data-en={home.whatWeDo.titleEn}>{home.whatWeDo.titleIt}</h2>
        <p class="lead" style="margin:.5em 0 1em" data-it={home.whatWeDo.leadIt} data-en={home.whatWeDo.leadEn}>{home.whatWeDo.leadIt}</p>
        <p style="color:var(--ink-soft)" data-it={home.whatWeDo.bodyIt} data-en={home.whatWeDo.bodyEn}>{home.whatWeDo.bodyIt}</p>
        <a class="btn btn-ghost" style="margin-top:26px" href="/chi-siamo" data-it={home.whatWeDo.linkTextIt} data-en={home.whatWeDo.linkTextEn}>{home.whatWeDo.linkTextIt}</a>
      </div>
      <div class="photo tall" style={`background-image:${images.data.homeStory ? `url('${images.data.homeStory}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div>
    </div>
  </section>

  <section class="block-2 alt">
    <div class="wrap">
      <div class="section-head" style="max-width:none">
        <p class="eyebrow" data-it={home.testimonials.eyebrowIt} data-en={home.testimonials.eyebrowEn}>{home.testimonials.eyebrowIt}</p>
        <h2 data-it={home.testimonials.titleIt} data-en={home.testimonials.titleEn}>{home.testimonials.titleIt}</h2>
      </div>
      <div class="carousel-wrap">
        <button class="car-btn car-prev" id="tPrev" aria-label="Precedenti">&#8592;</button>
        <div class="carousel" id="tCarousel">
          {testimonials.map((t) => (
            <div class="t"><div class="stars">{"★".repeat(t.data.rating || 5)}{"☆".repeat(5 - (t.data.rating || 5))}</div><p>&ldquo;{t.data.quote}&rdquo;</p><div class="who">{t.data.author}</div></div>
          ))}
        </div>
        <button class="car-btn car-next" id="tNext" aria-label="Successive">&#8594;</button>
      </div>
    </div>
  </section>
</Base>

<script>
  function initHomeCarousel() {
    const car = document.getElementById('tCarousel');
    if (!car || car.dataset.wired) return;
    car.dataset.wired = '1';
    const prev = document.getElementById('tPrev');
    const next = document.getElementById('tNext');
    function cardStep() {
      const card = car.querySelector('.t');
      if (!card) return 0;
      const style = getComputedStyle(car);
      const gap = parseFloat(style.columnGap || style.gap || '0');
      return card.getBoundingClientRect().width + gap;
    }
    function atEnd() {
      return car.scrollLeft + car.clientWidth >= car.scrollWidth - 4;
    }
    function advance() {
      if (atEnd()) {
        car.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        car.scrollBy({ left: cardStep(), behavior: 'smooth' });
      }
    }
    function goPrev() {
      if (car.scrollLeft <= 4) {
        car.scrollTo({ left: car.scrollWidth, behavior: 'smooth' });
      } else {
        car.scrollBy({ left: -cardStep(), behavior: 'smooth' });
      }
    }
    next?.addEventListener('click', () => { advance(); resetAutoplay(); });
    prev?.addEventListener('click', () => { goPrev(); resetAutoplay(); });

    function startAutoplay() { window.__egCarouselTimer = setInterval(advance, 5000); }
    function resetAutoplay() { clearInterval(window.__egCarouselTimer); startAutoplay(); }
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      startAutoplay();
      car.addEventListener('mouseenter', () => clearInterval(window.__egCarouselTimer));
      car.addEventListener('mouseleave', startAutoplay);
      car.addEventListener('touchstart', () => clearInterval(window.__egCarouselTimer), { passive: true });
      car.addEventListener('touchend', () => setTimeout(startAutoplay, 3000));
    }
  }
  clearInterval(window.__egCarouselTimer);
  document.addEventListener('astro:page-load', initHomeCarousel);
</script>
