---
import { getEntry } from 'astro:content';
const imagesEntry = await getEntry('siteImages', 'images');
const images = imagesEntry;
const PLACEHOLDER = "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20400%20500%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%238248E8%22%2F%3E%3Cstop%20offset%3D%22.55%22%20stop-color%3D%22%235F1CEC%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23241046%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22400%22%20height%3D%22500%22%20fill%3D%22url%28%2523g%29%22%2F%3E%3Cg%20stroke%3D%22%23ffffff%22%20stroke-opacity%3D%220.20%22%20stroke-width%3D%222%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M-20%20360%20C120%20290%20210%20420%20430%20320%22%2F%3E%3Cpath%20d%3D%22M-20%20410%20C140%20350%20250%20470%20430%20390%22%2F%3E%3Cpath%20d%3D%22M-20%20300%20C120%20250%20210%20350%20430%20260%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.15%22%3E%3Ccircle%20cx%3D%22205%22%20cy%3D%22180%22%20r%3D%2230%22%2F%3E%3Cpath%20d%3D%22M205%20212%20C182%20232%20188%20300%20172%20350%20L196%20350%20C205%20316%20212%20316%20220%20350%20L244%20350%20C230%20300%20236%20232%20205%20212%20Z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E'),linear-gradient(140deg,#CDB4E8,#9B6FD8 55%,#5F1CEC)";
import Base from '../layouts/Base.astro';
---
<Base title="L'esperienza — Ecstatic Grooves" description="Cos'è l'Ecstatic Dance, la musica, come si svolge una serata e le domande dei principianti.">
<section class="block" style="padding-top:150px">
    <div class="wrap two-col">
      <div>
        <p class="eyebrow" data-it="L'esperienza" data-en="The experience">L'esperienza</p>
        <h2 data-it="Cos'è l'<span class='uline'>Ecstatic Dance</span>?" data-en="What is <span class='uline'>ecstatic dance</span>?">Cos'è l'<span class="uline">Ecstatic Dance</span>?</h2>
        <p class="lead" style="margin-top:.6em" data-it="L'Ecstatic Dance è una forma di danza consapevole. Non c'è un solo modo di descriverla: certe sere è movimento con intenzione, altre è movimento libero senza alcuna direzione, a volte è una meditazione in movimento, o tutto questo insieme." data-en="Ecstatic dance is a form of conscious dance. There's no single way to describe it: some nights it's movement with intention, other nights it's free movement with no direction at all, and sometimes it's a moving meditation, or all of it at once.">L'Ecstatic Dance è una forma di danza consapevole. Non c'è un solo modo di descriverla: certe sere è movimento con intenzione, altre è movimento libero senza alcuna direzione, a volte è una meditazione in movimento, o tutto questo insieme.</p>
        <p style="color:var(--ink-soft);margin-top:1.1em" data-it="È ciò di cui hai bisogno in quel momento: uno spazio per sentire tutto ciò che affiora, gioia, tristezza e ogni sfumatura nel mezzo. È un momento che regali a te stessə, per ascoltare davvero il tuo corpo. Niente telefono, niente chiacchiere, solo spazio lontano da tutto ciò che la vita moderna di solito ti chiede." data-en="It's whatever you need it to be in that moment, a space to feel whatever comes up, joy, sadness, everything in between. It's a moment you give yourself, to really listen to your body. No phone, no small talk, just space away from everything modern life usually asks of you.">È ciò di cui hai bisogno in quel momento: uno spazio per sentire tutto ciò che affiora, gioia, tristezza e ogni sfumatura nel mezzo. È un momento che regali a te stessə, per ascoltare davvero il tuo corpo. Niente telefono, niente chiacchiere, solo spazio lontano da tutto ciò che la vita moderna di solito ti chiede.</p>
        <p style="color:var(--ink-soft);margin-top:1.1em" data-it="Sei energicə o stancə? Cosa cerca di comunicarti il corpo? Puoi vivere la danza come un momento per stare con te stessə, o per stare con gli altri. È uno spazio sicuro, guidato dalla comunità, e sei benvenutə a venire da solə o con amici. Un sabato sera al mese a Bologna." data-en="Are you energised or tired? What is your body trying to communicate? You can take the dance as a moment to be with yourself, or a moment to be with others. It's a safe, community-led space, and you're welcome to come alone or with friends. One Saturday evening a month in Bologna.">Sei energicə o stancə? Cosa cerca di comunicarti il corpo? Puoi vivere la danza come un momento per stare con te stessə, o per stare con gli altri. È uno spazio sicuro, guidato dalla comunità, e sei benvenutə a venire da solə o con amici. Un sabato sera al mese a Bologna.</p>
      </div>
      <div class="photo tall" style={`background-image:${images.data.experienceBody ? `url('${images.data.experienceBody}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div>
    </div>
  </section>

  <section class="block-2 alt">
    <div class="wrap two-col">
      <div class="photo tall" style={`background-image:${images.data.experienceMusic ? `url('${images.data.experienceMusic}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div>
      <div>
        <p class="eyebrow" data-it="La musica" data-en="The music">La musica</p>
        <h3 style="font-size:1.9rem;margin:.3em 0 .5em" data-it="Il cuore di tutto" data-en="At the core of it all">Il cuore di tutto</h3>
        <p style="color:var(--ink-soft)" data-it="La musica è il cuore dell'Ecstatic Dance. Durante la danza vivrai un viaggio che attraversa ritmi, stili e tempi da tutto il mondo. A differenza del clubbing, la nostra facilitazione musicale intreccia generi musicali diversi in un flusso che va da paesaggi meditativi a vibrazioni potenti e travolgenti." data-en="Music is at the core of Ecstatic Dance. During the dance you will experience a journey crossing rhythms, styles, and tempos from all over the world. Unlike clubbing, our musical facilitation weaves various genres of music into a flow that moves from meditative landscapes to powerful and uplifting vibrations.">La musica è il cuore dell'Ecstatic Dance. Durante la danza vivrai un viaggio che attraversa ritmi, stili e tempi da tutto il mondo. A differenza del clubbing, la nostra facilitazione musicale intreccia generi musicali diversi in un flusso che va da paesaggi meditativi a vibrazioni potenti e travolgenti.</p>
        <a class="sc-link" href="https://soundcloud.com/holly-hotpants" target="_blank" rel="noopener">
          <span class="sc-eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
          <span data-it="Ascolta i set di Holly" data-en="Listen to Holly's sets">Ascolta i set di Holly</span>
          <span class="sc-arrow" aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow" data-it="Cosa aspettarsi" data-en="What to expect">Cosa aspettarsi</p><h2 data-it="Come si svolge una serata" data-en="The shape of a night">Come si svolge una serata</h2></div>
      <div class="phases">
        <div class="phase"><span class="n"></span><h3 data-it="Radicamento" data-en="Grounding">Radicamento</h3><p data-it="Apriamo con momenti di radicamento e facilitazione, per entrare nello spazio e nel corpo prima che il viaggio cominci." data-en="We open with moments of grounding and facilitation, settling into the space and the body before the journey begins.">Apriamo con momenti di radicamento e facilitazione, per entrare nello spazio e nel corpo prima che il viaggio cominci.</p></div>
        <div class="phase"><span class="n"></span><h3 data-it="Il viaggio" data-en="The journey">Il viaggio</h3><p data-it="Attraverso movimento e suoni ti invitiamo a esplorare emozioni, energia e presenza, portato da una facilitazione musicale accuratamente selezionata." data-en="Through movement and sound you're invited to explore emotions, energy, and presence, carried by carefully curated musical facilitation.">Attraverso movimento e suoni ti invitiamo a esplorare emozioni, energia e presenza, portato da una facilitazione musicale accuratamente selezionata.</p></div>
        <div class="phase"><span class="n"></span><h3 data-it="Cerchio di chiusura" data-en="Closing circle">Cerchio di chiusura</h3><p data-it="Dopo la danza, un momento di chiusura aiuta a integrare l'esperienza. È anche l'occasione per conoscersi e crescere insieme come comunità." data-en="After the dance, a closing circle helps integrate the experience. It's also a chance to meet new people and grow together as a community.">Dopo la danza, un momento di chiusura aiuta a integrare l'esperienza. È anche l'occasione per conoscersi e crescere insieme come comunità.</p></div>
      </div>
    </div>
  </section>

  <section class="block-2 alt">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow" data-it="Gli accordi" data-en="Our agreements">Gli accordi</p><h2 data-it="Le nostre linee guida" data-en="Our guidelines">Le nostre linee guida</h2></div>
      <div class="grid-6">
        <div class="g"><h3 data-it="Niente chiacchiere" data-en="No chitchat">Niente chiacchiere</h3><p data-it="Quando parte la musica, comunica con il corpo e lascia riposare la mente." data-en="Once the music starts, communicate with your body and let your mind rest.">Quando parte la musica, comunica con il corpo e lascia riposare la mente.</p></div>
        <div class="g"><h3 data-it="Niente telefoni" data-en="No phones">Niente telefoni</h3><p data-it="Resta presente: niente foto o video, per evitare distrazioni e staccare dagli schermi." data-en="Stay present — no photos or videos, to avoid distractions and disconnect from screens.">Resta presente: niente foto o video, per evitare distrazioni e staccare dagli schermi.</p></div>
        <div class="g"><h3 data-it="Divertimento sobrio" data-en="Sober fun">Divertimento sobrio</h3><p data-it="Divertimento consapevole: niente alcol né sostanze durante i nostri eventi." data-en="Conscious fun, no alcohol or intoxicating substances during our events.">Divertimento consapevole: niente alcol né sostanze durante i nostri eventi.</p></div>
        <div class="g"><h3 data-it="A piedi nudi" data-en="Barefoot">A piedi nudi</h3><p data-it="Per esplorare tutti i movimenti fluidi del corpo danziamo scalzi, approfondendo la connessione con la terra." data-en="To explore all the body's fluid movements, we dance barefoot, deepening our connection to the earth.">Per esplorare tutti i movimenti fluidi del corpo danziamo scalzi, approfondendo la connessione con la terra.</p></div>
        <div class="g"><h3 data-it="Movimento libero" data-en="Free movement">Movimento libero</h3><p data-it="Nessun passo, schema o regola per il movimento o la quiete: sentiti libero di esprimerti con il corpo." data-en="There are no steps, patterns, or rules for movement or stillness — feel free to express yourself with your body.">Nessun passo, schema o regola per il movimento o la quiete: sentiti libero di esprimerti con il corpo.</p></div>
        <div class="g"><h3 data-it="Spazio sicuro" data-en="Safe space">Spazio sicuro</h3><p data-it="Tuttə sono benvenutə: teniamo uno spazio sicuro e privo di giudizio che accoglie tutti, onorando differenze e somiglianze." data-en="Everyone is welcome — we hold a safe, non-judgmental space that embraces all, honoring both our differences and our similarities.">Tuttə sono benvenutə: teniamo uno spazio sicuro e privo di giudizio che accoglie tutti, onorando differenze e somiglianze.</p></div>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap">
      <div class="section-head" style="margin:0 auto 40px;text-align:center"><p class="eyebrow" data-it="Prima di venire" data-en="Before you come">Prima di venire</p><h2 data-it="Le domande dei principianti" data-en="First-timer questions">Le domande dei principianti</h2></div>
      <div class="faq">
        <div class="fi"><button class="fq" data-it="Devo saper ballare?" data-en="Do I need to know how to dance?">Devo saper ballare?</button><div class="fa"><p data-it="Per niente. Non ci sono passi né modi giusti: solo spazio per esprimere ciò che sei, così come sei. Se puoi muoverti, puoi farlo." data-en="Not at all. There are no steps and nothing to get right — only space to express who you are, just as you are. If you can move, you can do this.">Per niente. Non ci sono passi né modi giusti: solo spazio per esprimere ciò che sei, così come sei. Se puoi muoverti, puoi farlo.</p></div></div>
        <div class="fi"><button class="fq" data-it="Posso venire da solə?" data-en="Can I come alone?">Posso venire da solə?</button><div class="fa"><p data-it="La maggior parte delle persone viene così. Troverai una comunità calorosa, e il cerchio di chiusura è il momento naturale per conoscersi." data-en="Most people do. You'll be among a warm, welcoming community — and the closing circle is a natural place to connect.">La maggior parte delle persone viene così. Troverai una comunità calorosa, e il cerchio di chiusura è il momento naturale per conoscersi.</p></div></div>
        <div class="fi"><button class="fq" data-it="Cosa indosso?" data-en="What should I wear?">Cosa indosso?</button><div class="fa"><p data-it="Abiti comodi in cui puoi muoverti. Si balla scalzi, quindi lascia le scarpe all'ingresso." data-en="Comfortable clothes you can move in. We dance barefoot, so leave the shoes at the door.">Abiti comodi in cui puoi muoverti. Si balla scalzi, quindi lascia le scarpe all'ingresso.</p></div></div>
        <div class="fi"><button class="fq" data-it="Le sessioni sono in italiano o in inglese?" data-en="Are sessions in Italian or English?">Le sessioni sono in italiano o in inglese?</button><div class="fa"><p data-it="Gli eventi sono facilitati in italiano e in inglese, e sono aperti a tuttə." data-en="Our events are facilitated in Italian and English, and are open to everyone.">Gli eventi sono facilitati in italiano e in inglese, e sono aperti a tuttə.</p></div></div>
        <div class="fi"><button class="fq" data-it="È davvero senza alcol?" data-en="Is it really alcohol-free?">È davvero senza alcol?</button><div class="fa"><p data-it="Sì. È divertimento consapevole: niente alcol né sostanze. L'unica ebbrezza è la musica e il movimento." data-en="Yes. It's conscious fun — no alcohol or substances. The only high is the music and the movement.">Sì. È divertimento consapevole: niente alcol né sostanze. L'unica ebbrezza è la musica e il movimento.</p></div></div>
        <div class="fi"><button class="fq" data-it="Quanto dura?" data-en="How long is it?">Quanto dura?</button><div class="fa"><p data-it="Circa due ore, incluse l'apertura e il cerchio di chiusura." data-en="Around two hours, including the opening and the closing circle.">Circa due ore, incluse l'apertura e il cerchio di chiusura.</p></div></div>
      </div>
    </div>
  </section>

  <section class="block-2 alt">
    <div class="wrap" style="max-width:680px;text-align:center">
      <p class="eyebrow" data-it="Scrivici" data-en="Get in touch">Scrivici</p>
      <h2 data-it="Hai ancora domande? Ci siamo noi." data-en="Still have questions? We're here.">Hai ancora domande? Ci siamo noi.</h2>
      <p style="color:var(--ink-soft);margin:.6em 0 1.4em" data-it="Se ti serve ancora qualcosa prima di fare il salto, che sia cosa aspettarti, se fa per te o qualsiasi altra cosa, scrivici e basta. Ci farebbe piacere aiutarti a sentirti prontə a danzare con noi." data-en="If you need a little more before taking the leap, whether it's what to expect, whether it's for you, or anything else, just write to us. We'd love to help you feel ready to dance with us.">Se ti serve ancora qualcosa prima di fare il salto, che sia cosa aspettarti, se fa per te o qualsiasi altra cosa, scrivici e basta. Ci farebbe piacere aiutarti a sentirti prontə a danzare con noi.</p>
      <a class="btn btn-solid" href="mailto:dance@ecstaticgrooves.com" data-it="Scrivici" data-en="Write to us">Scrivici</a>
      <p style="font-size:.86rem;color:var(--ink-soft);margin-top:.9em"><a href="mailto:dance@ecstaticgrooves.com" style="color:var(--berry);text-decoration:underline">dance@ecstaticgrooves.com</a></p>
      <p style="color:var(--ink-soft);font-size:.96rem;margin-top:2.2em" data-it="Hai già danzato con noi? Sei benvenutə nella nostra community WhatsApp, aperta a chi ha partecipato ad almeno una danza." data-en="Already danced with us? You're warmly welcome in our WhatsApp community, open to everyone who's joined us for at least one dance.">Hai già danzato con noi? Sei benvenutə nella nostra community WhatsApp, aperta a chi ha partecipato ad almeno una danza.</p>
      <a class="btn btn-ghost" style="margin-top:.9em" href="https://chat.whatsapp.com/Lr8PYGL62K3A3P9Z3Cf3yE" target="_blank" rel="noopener" data-it="Entra nella community" data-en="Join the community">Entra nella community</a>
    </div>
  </section>
</Base>
