---
import { getEntry } from 'astro:content';
const imagesEntry = await getEntry('siteImages', 'images');
const images = imagesEntry;
const PLACEHOLDER = "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20400%20500%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%238248E8%22%2F%3E%3Cstop%20offset%3D%22.55%22%20stop-color%3D%22%235F1CEC%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23241046%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22400%22%20height%3D%22500%22%20fill%3D%22url%28%2523g%29%22%2F%3E%3Cg%20stroke%3D%22%23ffffff%22%20stroke-opacity%3D%220.20%22%20stroke-width%3D%222%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M-20%20360%20C120%20290%20210%20420%20430%20320%22%2F%3E%3Cpath%20d%3D%22M-20%20410%20C140%20350%20250%20470%20430%20390%22%2F%3E%3Cpath%20d%3D%22M-20%20300%20C120%20250%20210%20350%20430%20260%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.15%22%3E%3Ccircle%20cx%3D%22205%22%20cy%3D%22180%22%20r%3D%2230%22%2F%3E%3Cpath%20d%3D%22M205%20212%20C182%20232%20188%20300%20172%20350%20L196%20350%20C205%20316%20212%20316%20220%20350%20L244%20350%20C230%20300%20236%20232%20205%20212%20Z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E'),linear-gradient(140deg,#CDB4E8,#9B6FD8 55%,#5F1CEC)";
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const events = (await getCollection('events')).sort((a, b) => a.id.localeCompare(b.id));
---
<Base title="Eventi — Ecstatic Grooves" description="Il calendario della stagione e la nostra casa a Bologna, OfficinAcrobatica.">
<section class="block" style="padding-top:150px">
    <div class="wrap">
      <div class="section-head"><p class="eyebrow" data-it="Unisciti a noi" data-en="Join us">Unisciti a noi</p><h2 data-it="Il calendario della stagione" data-en="The season's calendar">Il calendario della stagione</h2><p class="lead" data-it="Ci incontriamo un sabato sera al mese a Bologna, e le nostre serate seguono il ritmo delle stagioni e delle loro energie. Scegli la tua data e prenota il posto." data-en="We gather one Saturday evening a month in Bologna, and our evenings follow the rhythm of the seasons and their energies. Pick your date and book your spot.">Ci incontriamo un sabato sera al mese a Bologna, e le nostre serate seguono il ritmo delle stagioni e delle loro energie. Scegli la tua data e prenota il posto.</p></div>

      <div class="cal">
        {events.map((event) => (
          <div class="cal-row">
            <div class="cal-date"><span class="d">{event.data.day}</span><span class="m">{event.data.monthLabel}</span></div>
            <div class="cal-info"><h3 data-it={event.data.titleIt} data-en={event.data.titleEn}>{event.data.titleIt}</h3><p class="when">{event.data.venue}</p></div>
            <a class="btn btn-solid" href={event.data.ticketUrl} target="_blank" rel="noopener" data-it="Prenota" data-en="Book">Prenota</a>
          </div>
        ))}
      </div>
      <p class="meta" style="text-align:center;margin-top:22px" data-it="Ogni «Prenota» porta diretto al checkout di quella serata. Orario e tema di ciascun evento sono indicati nella sua pagina." data-en="Each “Book” goes straight to that night’s checkout. Time and theme for each event are shown on its page.">Ogni «Prenota» porta diretto al checkout di quella serata. Orario e tema di ciascun evento sono indicati nella sua pagina.</p>

      <div class="loc-card">
        <p class="eyebrow" data-it="La nostra casa" data-en="Our home">La nostra casa</p>
        <h3 data-it="OfficinAcrobatica, Bologna" data-en="OfficinAcrobatica, Bologna">OfficinAcrobatica, Bologna</h3>
        <div class="photo" style={`aspect-ratio:16/9;border-radius:14px;margin:16px 0 4px;background-image:${images.data.eventsLocation ? `url('${images.data.eventsLocation}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div>
        <p class="loc-intro" data-it="Ci troviamo a OfficinAcrobatica, la nostra casa nel cuore di Bologna: un hub creativo pieno di vita e movimento, dentro il DLF in Via Stalingrado 12 (40128). Ampio, accogliente e facile da raggiungere." data-en="We gather at OfficinAcrobatica, our home in the heart of Bologna: a creative hub full of life and movement, inside the DLF at Via Stalingrado 12 (40128). Spacious, warm and easy to reach.">Ci troviamo a OfficinAcrobatica, la nostra casa nel cuore di Bologna: un hub creativo pieno di vita e movimento, dentro il DLF in Via Stalingrado 12 (40128). Ampio, accogliente e facile da raggiungere.</p>
        <p class="loc-label" data-it="Come arrivare" data-en="How to get there">Come arrivare</p>
        <ul class="loc-how">
          <li data-it="🚍 Bus 25 o 35 dalla Stazione Centrale → fermata «Stalingrado» (3 min a piedi)" data-en="🚍 Bus 25 or 35 from Central Station → «Stalingrado» stop (3 min walk)">🚍 Bus 25 o 35 dalla Stazione Centrale → fermata «Stalingrado» (3 min a piedi)</li>
          <li data-it="🚶 A piedi: 15–20 minuti dalla Stazione Centrale" data-en="🚶 On foot: 15–20 minutes from Central Station">🚶 A piedi: 15–20 minuti dalla Stazione Centrale</li>
          <li data-it="🚗 In auto: parcheggio gratuito del DLF (ingresso da Via Sebastiano Serlio)" data-en="🚗 By car: free parking at the DLF (entrance from Via Sebastiano Serlio)">🚗 In auto: parcheggio gratuito del DLF (ingresso da Via Sebastiano Serlio)</li>
          <li data-it="👉 All'interno del DLF, segui i cartelli gialli «OfficinAcrobatica»" data-en="👉 Inside the DLF, follow the yellow «OfficinAcrobatica» signs">👉 All'interno del DLF, segui i cartelli gialli «OfficinAcrobatica»</li>
        </ul>
        <a class="btn btn-ghost" href="https://www.google.com/maps/search/?api=1&query=OfficinAcrobatica+Via+Stalingrado+12+Bologna" target="_blank" rel="noopener" data-it="Apri in mappa" data-en="Open in maps">Apri in mappa</a>
      </div>

      <div class="two-col" style="margin-top:64px">
        <div class="photo tall" style={`background-image:${images.data.eventsFirstTime ? `url('${images.data.eventsFirstTime}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div>
        <div>
          <p class="eyebrow" data-it="Buono a sapersi" data-en="Good to know">Buono a sapersi</p>
          <h3 style="font-size:1.8rem;margin:.3em 0 .5em" data-it="Un viaggio che sale come un'onda" data-en="A journey that rises like a wave">Un viaggio che sale come un'onda</h3>
          <p style="color:var(--ink-soft)" data-it="Un sabato sera al mese, un viaggio musicale che sale come un'onda accompagna il tuo movimento facilitato, a piedi nudi, senza alcol e senza giudizio. Tutto ciò che ti serve per sentirti prontə è nella pagina L'esperienza." data-en="One Saturday evening a month, a musical journey that rises like a wave carries your facilitated movement, barefoot, alcohol-free and judgment-free. Everything you need to feel ready is on The Experience page.">Un sabato sera al mese, un viaggio musicale che sale come un'onda accompagna il tuo movimento facilitato, a piedi nudi, senza alcol e senza giudizio. Tutto ciò che ti serve per sentirti prontə è nella pagina L'esperienza.</p>
          <a class="btn btn-ghost" style="margin-top:22px" href="/esperienza" data-it="Leggi la guida" data-en="Read the guide">Leggi la guida</a>
        </div>
      </div>
    </div>
  </section>
</Base>
