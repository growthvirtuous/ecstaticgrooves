---
import { getEntry } from 'astro:content';
const imagesEntry = await getEntry('siteImages', 'images');
const images = imagesEntry;
const PLACEHOLDER = "url('data:image/svg+xml,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%20400%20500%22%20preserveAspectRatio%3D%22xMidYMid%20slice%22%3E%3Cdefs%3E%3ClinearGradient%20id%3D%22g%22%20x1%3D%220%22%20y1%3D%220%22%20x2%3D%221%22%20y2%3D%221%22%3E%3Cstop%20offset%3D%220%22%20stop-color%3D%22%238248E8%22%2F%3E%3Cstop%20offset%3D%22.55%22%20stop-color%3D%22%235F1CEC%22%2F%3E%3Cstop%20offset%3D%221%22%20stop-color%3D%22%23241046%22%2F%3E%3C%2FlinearGradient%3E%3C%2Fdefs%3E%3Crect%20width%3D%22400%22%20height%3D%22500%22%20fill%3D%22url%28%2523g%29%22%2F%3E%3Cg%20stroke%3D%22%23ffffff%22%20stroke-opacity%3D%220.20%22%20stroke-width%3D%222%22%20fill%3D%22none%22%3E%3Cpath%20d%3D%22M-20%20360%20C120%20290%20210%20420%20430%20320%22%2F%3E%3Cpath%20d%3D%22M-20%20410%20C140%20350%20250%20470%20430%20390%22%2F%3E%3Cpath%20d%3D%22M-20%20300%20C120%20250%20210%20350%20430%20260%22%2F%3E%3C%2Fg%3E%3Cg%20fill%3D%22%23ffffff%22%20fill-opacity%3D%220.15%22%3E%3Ccircle%20cx%3D%22205%22%20cy%3D%22180%22%20r%3D%2230%22%2F%3E%3Cpath%20d%3D%22M205%20212%20C182%20232%20188%20300%20172%20350%20L196%20350%20C205%20316%20212%20316%20220%20350%20L244%20350%20C230%20300%20236%20232%20205%20212%20Z%22%2F%3E%3C%2Fg%3E%3C%2Fsvg%3E'),linear-gradient(140deg,#CDB4E8,#9B6FD8 55%,#5F1CEC)";
import Base from '../layouts/Base.astro';
---
<Base title="Blog — Ecstatic Grooves" description="Racconti e riflessioni dalla nostra comunità.">
<section class="block" style="padding-top:150px">
    <div class="wrap">
      <div class="section-head" style="max-width:58ch">
        <p class="eyebrow" data-it="Il diario" data-en="The journal">Il diario</p>
        <h2 data-it="Racconti e riflessioni" data-en="Stories & reflections">Racconti e riflessioni</h2>
        <p class="lead" data-it="Dalla nostra comunità." data-en="From our community.">Dalla nostra comunità.</p>
      </div>
      <div class="blog-grid">
        <a class="bcard" href="/blog/ecstatic-dance-bologna"><div class="photo card" style={`background-image:${images.data.blogCoverPillar ? `url('${images.data.blogCoverPillar}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div><p class="cat" data-it="Guida" data-en="Guide">Guida</p><h3 data-it="Ecstatic Dance a Bologna? Io ci sono!" data-en="Ecstatic dance in Bologna? Count me in!">Ecstatic Dance a Bologna? Io ci sono!</h3><p data-it="Cos'è l'Ecstatic Dance, cosa aspettarti a una serata, la musica, le regole e i benefici: la guida completa per chi arriva a Bologna." data-en="What ecstatic dance is, what to expect at a gathering, the music, the guidelines and the benefits: the complete guide for anyone arriving in Bologna.">Cos'è l'Ecstatic Dance, cosa aspettarti a una serata, la musica, le regole e i benefici: la guida completa per chi arriva a Bologna.</p><span class="rd" data-it="Leggi →" data-en="Read →">Leggi →</span></a>
        <a class="bcard" href="/blog/finding-my-way-home"><div class="photo card" style={`background-image:${images.data.blogCoverHome ? `url('${images.data.blogCoverHome}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div><p class="cat" data-it="Racconto" data-en="Story">Racconto</p><h3 data-it="Ritrovare la strada di casa" data-en="Finding my way home">Ritrovare la strada di casa</h3><p data-it="Holly torna in Galles per riscoprire le sue radici celtiche e riportarle nella danza, tra stagioni e cicli lunari." data-en="Holly returns to Wales to rediscover her Celtic roots and bring them into the dance, through seasons and moon cycles.">Holly torna in Galles per riscoprire le sue radici celtiche e riportarle nella danza, tra stagioni e cicli lunari.</p><span class="rd" data-it="Leggi →" data-en="Read →">Leggi →</span></a>
        <a class="bcard" href="/blog/dancing-for-the-planet"><div class="photo card" style={`background-image:${images.data.blogCoverPlanet ? `url('${images.data.blogCoverPlanet}')` : PLACEHOLDER};background-size:cover;background-position:center`}></div><p class="cat" data-it="Restituire" data-en="Giving back">Restituire</p><h3 data-it="Danzare per il pianeta" data-en="Dancing for the planet">Danzare per il pianeta</h3><p data-it="Perché il 5% di ogni biglietto che acquisti per Ecstatic Grooves va a EarthPercent, e cosa sostiene davvero." data-en="Why 5% of every ticket you buy for Ecstatic Grooves goes to EarthPercent, and what that actually supports.">Perché il 5% di ogni biglietto che acquisti per Ecstatic Grooves va a EarthPercent, e cosa sostiene davvero.</p><span class="rd" data-it="Leggi →" data-en="Read →">Leggi →</span></a>
      </div>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:640px">
      <div class="callout">
        <p class="eyebrow" data-it="Resta nel cerchio" data-en="Stay in the circle">Resta nel cerchio</p>
        <h2 data-it="Non perderti le prossime storie" data-en="Don't miss the next stories">Non perderti le prossime storie</h2>
        <p data-it="Iscriviti alla newsletter per ricevere i prossimi eventi e le nuove storie dalla nostra comunità. Una volta al mese, niente rumore." data-en="Subscribe to get upcoming events and new stories from our community. Once a month, no noise.">Iscriviti alla newsletter per ricevere i prossimi eventi e le nuove storie dalla nostra comunità. Una volta al mese, niente rumore.</p>
        <div class="news"><input type="email" data-it-ph="La tua email" data-en-ph="Your email" placeholder="La tua email" aria-label="Email"><button class="btn btn-solid" onclick="fakeSub(this)" data-it="Iscriviti" data-en="Subscribe">Iscriviti</button></div>
      </div>
    </div>
  </section>
</Base>
