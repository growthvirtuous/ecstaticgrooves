---
const path = Astro.url.pathname;
const active = (p) => (p === '/' ? path === '/' : path.startsWith(p));
---
<nav id="nav">
  <a class="logo-link" href="/" aria-label="Ecstatic Grooves"><img class="logo" src="/logo.svg" alt="Ecstatic Grooves" /></a>
  <div class="nav-links" id="navlinks">
    <a class:list={["navlink", {active: active('/')}]} href="/" data-it="Home" data-en="Home">Home</a>
    <a class:list={["navlink", {active: active('/esperienza')}]} href="/esperienza" data-it="L'esperienza" data-en="The experience">L'esperienza</a>
    <a class:list={["navlink", {active: active('/chi-siamo')}]} href="/chi-siamo" data-it="Chi siamo" data-en="About">Chi siamo</a>
    <a class:list={["navlink", {active: active('/blog')}]} href="/blog" data-it="Blog" data-en="Blog">Blog</a>
    <a class="btn btn-solid btn-ticket-nav" href="/eventi" data-it="I nostri eventi" data-en="Our events">I nostri eventi</a>
    <div class="nav-follow">
      <span class="nav-follow-label" data-it="Segui" data-en="Follow us">Segui</span>
      <a href="https://www.instagram.com/ecstaticgrooves" target="_blank" rel="noopener" aria-label="Instagram" class="social-icon nav-social-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none"/></svg></a>
      <a href="https://www.facebook.com/204188562782313" target="_blank" rel="noopener" aria-label="Facebook" class="social-icon nav-social-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9.5"/><path d="M14 8.5h-1.5c-1 0-1.5.5-1.5 1.5v2h3l-.4 3h-2.6v6.3" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
      <a href="https://www.linkedin.com/company/ecstatic-grooves" target="_blank" rel="noopener" aria-label="LinkedIn" class="social-icon nav-social-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="3" width="18" height="18" rx="4"/><path d="M8 10.5v6M8 7.8v.01" stroke-linecap="round"/><path d="M12 16.5v-3.6c0-1.4 1-2.4 2.2-2.4S16 11.5 16 12.9v3.6" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
    </div>
  </div>
  <div class="nav-right">
    <div class="lang"><button id="it" class="on" onclick="setLang('it')">IT</button><span class="sep">/</span><button id="en" onclick="setLang('en')">EN</button></div>
    <button class="burger" id="burger" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</nav>
